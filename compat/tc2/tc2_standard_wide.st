// Tc2_Standard wide-string functions (TwinCAT 3 PLC Library Tc2_Standard).
// W* signatures mirror IEC 61131-3 string functions; bodies delegate to the
// same builtins, which already accept WSTRING operands.
// Sources: docs/plc/plan/21-twincat-libraries.md §7.

FUNCTION WCONCAT : WSTRING
VAR_INPUT
    STR1 : WSTRING;
    STR2 : WSTRING;
END_VAR
    WCONCAT := CONCAT(STR1, STR2);
END_FUNCTION

FUNCTION WDELETE : WSTRING
VAR_INPUT
    STR1 : WSTRING;
    LEN  : INT;
    POS  : INT;
END_VAR
    WDELETE := DELETE(STR1, LEN, POS);
END_FUNCTION

FUNCTION WFIND : INT
VAR_INPUT
    STR1 : WSTRING;
    STR2 : WSTRING;
END_VAR
    WFIND := FIND(STR1, STR2);
END_FUNCTION

FUNCTION WINSERT : WSTRING
VAR_INPUT
    STR1 : WSTRING;
    STR2 : WSTRING;
    POS  : INT;
END_VAR
    WINSERT := INSERT(STR1, STR2, POS);
END_FUNCTION

FUNCTION WLEFT : WSTRING
VAR_INPUT
    STR  : WSTRING;
    SIZE : INT;
END_VAR
    WLEFT := LEFT(STR, SIZE);
END_FUNCTION

FUNCTION WLEN : INT
VAR_INPUT
    STR : WSTRING;
END_VAR
    WLEN := LEN(STR);
END_FUNCTION

FUNCTION WMID : WSTRING
VAR_INPUT
    STR  : WSTRING;
    LEN  : INT;
    POS  : INT;
END_VAR
    WMID := MID(STR, LEN, POS);
END_FUNCTION

FUNCTION WREPLACE : WSTRING
VAR_INPUT
    STR1 : WSTRING;
    STR2 : WSTRING;
    L    : INT;
    P    : INT;
END_VAR
    WREPLACE := REPLACE(STR1, STR2, L, P);
END_FUNCTION

FUNCTION WRIGHT : WSTRING
VAR_INPUT
    STR  : WSTRING;
    SIZE : INT;
END_VAR
    WRIGHT := RIGHT(STR, SIZE);
END_FUNCTION
