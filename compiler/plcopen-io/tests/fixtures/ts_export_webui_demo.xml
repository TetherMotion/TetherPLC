<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://www.plcopen.org/xml/tc6_0200" xmlns:tether="http://tether.dev/plc/tc6ext">
  <fileHeader companyName="TetherMotion" productName="TetherPLC" productVersion="1" creationDateTime="2026-11-07T20:09:50.061Z">
  </fileHeader>
  <contentHeader name="webui_demo">
  </contentHeader>
  <types>
    <pous>
      <pou name="MAIN" pouType="program">
        <interface>
          <inputVars>
            <variable name="Limit" type="INT">
              <initialValue>
                <simpleValue value="90"/>
              </initialValue>
            </variable>
          </inputVars>
          <localVars>
            <variable name="Start" type="BOOL" address="%IX0.0">
            </variable>
            <variable name="Heat" type="BOOL" address="%QX0.0">
            </variable>
            <variable name="T1" type="TON">
            </variable>
          </localVars>
        </interface>
        <body>
          <FBD>
            <tether:network id="net1" kind="fbd" label="heat loop">
              <inVariable localId="1" tether:name="Start">
                <position x="0" y="0"/>
                <connectionPointOut>
                  <expression>
                    %IX0.0
                  </expression>
                </connectionPointOut>
              </inVariable>
              <block localId="2" typeName="TON" instanceName="T1" executionOrderId="1">
                <position x="4" y="0"/>
                <inputVariables>
                  <variable formalParameter="IN">
                    <connectionPointIn>
                      <connection refLocalId="1" tether:wire="20" tether:probe="true"/>
                    </connectionPointIn>
                  </variable>
                  <variable formalParameter="PT">
                    <connectionPointIn>
                      <expression>
                        T#200ms
                      </expression>
                    </connectionPointIn>
                  </variable>
                </inputVariables>
                <outputVariables>
                  <variable formalParameter="Q">
                    <connectionPointOut/>
                  </variable>
                </outputVariables>
              </block>
              <block localId="3" typeName="AND" executionOrderId="2">
                <position x="7" y="0"/>
                <inputVariables>
                  <variable formalParameter="IN0">
                    <connectionPointIn>
                      <connection refLocalId="1" tether:wire="20" tether:probe="true"/>
                    </connectionPointIn>
                  </variable>
                  <variable formalParameter="IN1">
                    <connectionPointIn>
                      <connection refLocalId="2" formalParameter="Q" tether:wire="21"/>
                    </connectionPointIn>
                  </variable>
                </inputVariables>
                <outputVariables>
                  <variable>
                    <connectionPointOut/>
                  </variable>
                </outputVariables>
              </block>
              <outVariable localId="4" tether:name="Heat">
                <position x="11" y="0"/>
                <connectionPointIn>
                  <connection refLocalId="3" tether:wire="22"/>
                </connectionPointIn>
                <expression>
                  %QX0.0
                </expression>
              </outVariable>
              <comment localId="50">
                <position x="4" y="4"/>
                <content>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">
                    heater control
                  </xhtml>
                </content>
              </comment>
              <label localId="51" label="L1">
                <position x="0" y="0"/>
              </label>
              <jump localId="52" label="L1">
                <position x="9" y="0"/>
              </jump>
              <return localId="53">
                <position x="10" y="0"/>
              </return>
            </tether:network>
          </FBD>
        </body>
      </pou>
    </pous>
  </types>
  <addData>
    <data name="tether:tasks" handleUnknown="implementation">
      <tether:task name="CYC" period_ns="20000000" priority="3">
        <tether:program ref="MAIN"/>
      </tether:task>
    </data>
  </addData>
</project>
